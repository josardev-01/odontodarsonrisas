# Desarrollo local exclusivamente. Copiar a .env y no versionar ese archivo.
COMPOSE_PROJECT_NAME=dar-sonrisas
APP_ENV=development
LOG_LEVEL=INFO
POSTGRES_DB=dar_sonrisas
POSTGRES_USER=dar_sonrisas
# Reemplazar antes de iniciar. Este valor no es apto para ningun entorno compartido.
POSTGRES_PASSWORD=change-me-local-only
DATABASE_URL=postgresql+asyncpg://dar_sonrisas:change-me-local-only@db:5432/dar_sonrisas
# Lista JSON consumida por FastAPI. El proxy del frontend evita CORS en uso normal.
CORS_ORIGINS=["http://localhost:8080"]
AUTO_CREATE_SCHEMA=false
SEED_SYNTHETIC_PROFESSIONALS=true
# Se usa una sola vez para crear el primer administrador. Use otro secreto distinto
# de POSTGRES_PASSWORD, de al menos 32 caracteres aleatorios.
BOOTSTRAP_TOKEN=change-me-with-a-random-bootstrap-token
SESSION_TTL_HOURS=8

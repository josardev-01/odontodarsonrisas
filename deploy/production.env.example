# Ejemplo sin secretos. Guardar el archivo real fuera del repositorio, modo 0600.
APP_ENV=production
SITE_DOMAIN=www.darsonrisaspy.com
POSTGRES_DB=dar_sonrisas
POSTGRES_USER=dar_sonrisas
# Usar un secreto aleatorio alfanumerico largo para que la URL no necesite escape.
POSTGRES_PASSWORD=REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD
DATABASE_URL=postgresql+asyncpg://dar_sonrisas:REPLACE_WITH_RANDOM_ALPHANUMERIC_PASSWORD@db:5432/dar_sonrisas
BOOTSTRAP_TOKEN=REPLACE_WITH_DISTINCT_RANDOM_TOKEN_AT_LEAST_32_CHARACTERS
SESSION_TTL_HOURS=8
